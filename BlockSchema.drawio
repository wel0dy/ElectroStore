<mxfile host="app.diagrams.net">
  <diagram name="Алгоритм ElectroStoreApp" id="electro-gost-diagram">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Начало" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="334" y="20" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Отображение окна авторизации&#xa;(LoginWindow)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="304" y="90" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Вход как гость?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="324" y="165" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Ввод логина и пароля,&#xa;запрос к БД (app_user)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="304" y="260" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Пользователь найден?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="324" y="335" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Вывод сообщения об ошибке&#xa;авторизации" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="345" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Установка роли Гость&#xa;(Session.CurrentUser = null)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="175" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Настройка интерфейса по роли&#xa;(скрытие/показ фильтров и CRUD)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="294" y="435" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Загрузка списка товаров из БД&#xa;и замер времени (Stopwatch)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="294" y="510" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Применение поиска, фильтра&#xa;по поставщику и сортировки" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="294" y="585" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Роль = Администратор и выбран&#xa;добавить/изменить товар?" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="304" y="660" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Открытие ProductEditWindow,&#xa;валидация и сжатие фото 300×200" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="675" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Выполнение INSERT / UPDATE /&#xa;DELETE (с проверкой order_item)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
