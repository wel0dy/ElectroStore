<Window x:Class="ElectroStoreApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему — Магазин электроники"
        Icon="pack://application:,,,/ElectroStoreApp;component/Images/Logo.ico"
        Height="480" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="30" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/ElectroStoreApp;component/Images/Logo.png" Height="90" Stretch="Uniform" Margin="0,0,0,16"/>
        <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="LoginTextBox" Margin="0,4,0,12" Padding="4"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordInput" Margin="0,4,0,20" Padding="4"/>
        <Button x:Name="LoginButton" Content="Войти" IsDefault="True" Click="LoginButton_Click"/>
        <Button x:Name="GuestButton" Content="Войти как гость" Click="GuestButton_Click"/>
    </StackPanel>
</Window>
