<Window x:Class="ElectroStoreApp.ProductListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список товаров — Магазин электроники"
        Icon="pack://application:,,,/ElectroStoreApp;component/Images/Logo.ico"
        Height="780" Width="1140"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBigDiscount}" Value="True">
                    <Setter Property="Background" Value="#2E8B57"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                    <Setter Property="Background" Value="#FF8080"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AdditionalBackgroundBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/ElectroStoreApp;component/Images/Logo.png" Height="48" Stretch="Uniform"/>

                <TextBlock Grid.Column="1" Text="Список товаров" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserNameTextBlock" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="RoleTextBlock" HorizontalAlignment="Right"/>
                    <Button x:Name="LogoutButton" Content="Выйти" HorizontalAlignment="Right"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="12,8,12,0">
            <WrapPanel x:Name="FilterPanel" Margin="0,0,0,6" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="SearchTextBox" Width="260" Padding="4" Margin="0,0,16,0"
                         ToolTip="Поиск по артикулу, названию, описанию, категории, производителю, поставщику"
                         TextChanged="SearchTextBox_TextChanged"/>

                <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SupplierFilterComboBox" Width="190" Padding="4" Margin="0,0,16,0"
                          SelectionChanged="SupplierFilterComboBox_SelectionChanged"/>

                <TextBlock Text="Сортировка по остатку:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SortComboBox" Width="210" Padding="4"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="По умолчанию" IsSelected="True"/>
                    <ComboBoxItem Content="По возрастанию остатка"/>
                    <ComboBoxItem Content="По убыванию остатка"/>
                </ComboBox>
            </WrapPanel>

            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="AddProductButton" Content="Добавить товар" Click="AddProductButton_Click"/>
                <Button x:Name="OrdersButton" Content="Заказы" Click="OrdersButton_Click"/>
                <TextBlock x:Name="AdminHintTextBlock"
                           Text="Подсказка: нажмите на карточку товара, чтобы редактировать или удалить её"
                           Foreground="DimGray" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </WrapPanel>
        </StackPanel>

        <ListBox x:Name="ProductsListBox" Grid.Row="2" Margin="12"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseLeftButtonUp="ProductsListBox_MouseLeftButtonUp">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ProductCardStyle}">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Margin="2">
                                <Image Source="{Binding Photo}" Width="150" Height="100"
                                       Stretch="Uniform" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1"
                                    Margin="2" Padding="10,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="Bold" FontSize="16" TextWrapping="Wrap">
                                        <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding ProductName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description, StringFormat=Описание товара: {0}}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ManufacturerName, StringFormat=Производитель: {0}}"/>
                                    <TextBlock Text="{Binding SupplierName, StringFormat=Поставщик: {0}}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N2}}"
                                                   Foreground="Red"
                                                   TextDecorations="Strikethrough"
                                                   Margin="0,0,8,0"
                                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2}}"
                                                   Foreground="Black"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UnitName, StringFormat=Единица измерения: {0}}"/>
                                    <TextBlock Text="{Binding StockQuantity, StringFormat=Количество на складе: {0}}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="2" Margin="2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Действующая скидка" TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                               FontSize="26" FontWeight="Bold"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Background="#F5F5F5" Padding="12,6" BorderBrush="LightGray" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusTextBlock" Foreground="DimGray"/>
        </Border>
    </Grid>
</Window>
